# Copy to .env and adjust. The defaults are for local development only.

# MongoDB
MONGO_INITDB_DATABASE=companiesdatabase
MONGO_PORT=27017

# Backend (Flask API)
BACKEND_PORT=5001

# Frontend (built Vue app served by nginx). VITE_API_URL is baked in at build time.
FRONTEND_PORT=8080
VITE_API_URL=http://localhost:5001

# Mongo Express (optional, start with: docker compose --profile tools up)
MONGO_EXPRESS_PORT=8081
ME_CONFIG_BASICAUTH_USERNAME=mongo-express-user
ME_CONFIG_BASICAUTH_PASSWORD=mongo-express-user-pw
